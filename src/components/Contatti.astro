---
import Icon from "./Icon.astro";
---

<section id="contatti" class="scroll-mt-28 border-t border-[#2c2c2c]/[0.06] bg-white py-24 md:py-32">
	<div class="mx-auto max-w-7xl px-5 md:px-8">
		<div class="flex flex-col gap-10 lg:gap-12">
			<div class="grid gap-14 lg:grid-cols-12 lg:items-start lg:gap-12">
				<div class="lg:col-span-5" data-animate>
					<p class="text-xs font-semibold uppercase tracking-[0.3em] text-[#18b24b]">Contatti</p>
					<h2 class="mt-4 text-3xl font-bold tracking-tight text-[#2c2c2c] md:text-4xl">
						Parliamo del tuo prossimo giro
					</h2>
					<p class="mt-5 text-base leading-relaxed text-[#2c2c2c]/75">
						Scrivici per un tour, un noleggio o una consulenza in sede. Ti rispondiamo al più presto.
					</p>

					<ul class="mt-10 space-y-5 text-[#2c2c2c]">
						<li class="flex gap-4">
							<span class="mt-0.5 shrink-0 text-[#18b24b]" aria-hidden="true">
								<Icon name="map-pin" class="h-5 w-5" />
							</span>
							<div>
								<p class="text-xs font-semibold uppercase tracking-wider text-[#2c2c2c]/45">Indirizzo</p>
								<p class="mt-1 font-medium">Via Vittorio Veneto 104, Borgosesia (VC)</p>
							</div>
						</li>
						<li class="flex gap-4">
							<span class="mt-0.5 shrink-0 text-[#18b24b]" aria-hidden="true">
								<Icon name="mail" class="h-5 w-5" />
							</span>
							<div>
								<p class="text-xs font-semibold uppercase tracking-wider text-[#2c2c2c]/45">Email</p>
								<a href="mailto:info@spservicess.it" class="mt-1 font-medium text-[#18b24b] hover:underline">
									info@spservicess.it
								</a>
							</div>
						</li>
						<li class="flex gap-4">
							<span class="mt-0.5 shrink-0 text-[#18b24b]" aria-hidden="true">
								<Icon name="phone" class="h-5 w-5" />
							</span>
							<div>
								<p class="text-xs font-semibold uppercase tracking-wider text-[#2c2c2c]/45">Telefono</p>
								<a href="tel:+393476987492" class="mt-1 font-medium text-[#18b24b] hover:underline">
									347 6987492
								</a>
							</div>
						</li>
					</ul>
				</div>

				<div class="flex justify-center lg:col-span-7 lg:justify-end" data-animate>
					<div
						class="w-full max-w-xl overflow-hidden rounded-2xl bg-brand-cream p-6 shadow-inner ring-1 ring-[#2c2c2c]/[0.06] md:rounded-[1.75rem] md:p-7"
					>
						<form method="POST" class="space-y-4" name="contatti">
							<div class="grid gap-4 sm:grid-cols-2">
								<div class="sm:col-span-2">
									<label for="nome" class="mb-1 block text-xs font-semibold uppercase tracking-wider text-[#2c2c2c]/55"
										>Nome e cognome</label
									>
									<input
										type="text"
										id="nome"
										name="nome"
										required
										class="w-full rounded-lg border border-[#2c2c2c]/10 bg-white px-3 py-2.5 text-sm text-[#2c2c2c] shadow-sm transition focus:border-[#18b24b] focus:outline-none focus:ring-2 focus:ring-[#18b24b]/25"
									/>
								</div>
								<div>
									<label for="email" class="mb-1 block text-xs font-semibold uppercase tracking-wider text-[#2c2c2c]/55"
										>Email</label
									>
									<input
										type="email"
										id="email"
										name="email"
										required
										class="w-full rounded-lg border border-[#2c2c2c]/10 bg-white px-3 py-2.5 text-sm text-[#2c2c2c] shadow-sm transition focus:border-[#18b24b] focus:outline-none focus:ring-2 focus:ring-[#18b24b]/25"
									/>
								</div>
								<div>
									<label for="telefono" class="mb-1 block text-xs font-semibold uppercase tracking-wider text-[#2c2c2c]/55"
										>Telefono</label
									>
									<input
										type="tel"
										id="telefono"
										name="telefono"
										class="w-full rounded-lg border border-[#2c2c2c]/10 bg-white px-3 py-2.5 text-sm text-[#2c2c2c] shadow-sm transition focus:border-[#18b24b] focus:outline-none focus:ring-2 focus:ring-[#18b24b]/25"
									/>
								</div>
								<div class="sm:col-span-2">
									<label
										for="messaggio"
										class="mb-1 block text-xs font-semibold uppercase tracking-wider text-[#2c2c2c]/55"
										>Messaggio</label
									>
									<textarea
										id="messaggio"
										name="messaggio"
										rows="4"
										required
										class="w-full resize-y rounded-lg border border-[#2c2c2c]/10 bg-white px-3 py-2.5 text-sm text-[#2c2c2c] shadow-sm transition focus:border-[#18b24b] focus:outline-none focus:ring-2 focus:ring-[#18b24b]/25"
									></textarea>
								</div>
								<div class="sm:col-span-2 flex items-start gap-3">
									<input
										type="checkbox"
										id="privacy"
										name="privacy"
										required
										class="mt-1 h-4 w-4 rounded border-[#2c2c2c]/20 text-[#18b24b] focus:ring-[#18b24b]"
									/>
									<label for="privacy" class="text-xs leading-relaxed text-[#2c2c2c]/75 md:text-sm">
										Ho letto l’
										<a href="/privacy" class="font-medium text-[#18b24b] underline underline-offset-2 hover:text-[#0e7a30]"
											>informativa sulla privacy</a
										>
									</label>
								</div>
								<div class="sm:col-span-2">
									<button
										type="submit"
										class="w-full rounded-full bg-[#18b24b] py-3 text-sm font-semibold text-white shadow-lg shadow-[#18b24b]/25 transition hover:bg-[#0e7a30]"
									>
										Invia richiesta
									</button>
								</div>
							</div>
						</form>
					</div>
				</div>
			</div>

			<div class="overflow-hidden rounded-[2rem] shadow-2xl ring-1 ring-black/10" data-animate>
				<iframe
					src="https://maps.google.com/maps?q=Via+Vittorio+Veneto+104,+Borgosesia&output=embed"
					class="h-[min(52vh,420px)] w-full border-0 md:h-96"
					loading="lazy"
					title="Valsesia Electric Green, Mappa sede"></iframe>
			</div>
		</div>
	</div>
</section>
