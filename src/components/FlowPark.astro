---
const tracks: {
	title: string;
	text: string;
	tag: string;
	border: string;
	glow: string;
}[] = [
	{
		title: "Pump Track",
		tag: "Principiante",
		text: "Ritmo e tecnica di base: il punto ideale per prendere confidenza con curve e trasferimenti di peso.",
		border: "border-emerald-400/45 hover:border-emerald-400/65",
		glow: "shadow-[0_0_60px_-12px_rgba(52,211,153,0.35)]",
	},
	{
		title: "Pista cross",
		tag: "Intermedio",
		text: "Tracciato misto con salti e cambi di pendenza: adrenalina controllata e lettura del terreno.",
		border: "border-amber-400/45 hover:border-amber-400/65",
		glow: "shadow-[0_0_60px_-12px_rgba(251,191,36,0.3)]",
	},
	{
		title: "Pista enduro",
		tag: "Avanzato",
		text: "Terreno impegnativo e passaggi tecnici: pensata per chi cerca precisione e sfida continua.",
		border: "border-red-500/45 hover:border-red-500/70",
		glow: "shadow-[0_0_60px_-12px_rgba(239,68,68,0.35)]",
	},
];
---

<section id="flow" class="scroll-mt-28 relative overflow-hidden bg-[#0a0c0b] py-28 text-white md:py-36">
	<!-- Luce ambientale + texture -->
	<div class="pointer-events-none absolute inset-0" aria-hidden="true">
		<div
			class="absolute -left-[20%] top-0 h-[min(90vw,560px)] w-[min(90vw,560px)] rounded-full bg-emerald-500/[0.07] blur-[100px]"
		>
		</div>
		<div
			class="absolute -right-[15%] bottom-0 h-[min(70vw,480px)] w-[min(70vw,480px)] rounded-full bg-red-600/[0.06] blur-[90px]"
		>
		</div>
		<div
			class="absolute left-1/2 top-1/3 h-[280px] w-[400px] -translate-x-1/2 rounded-full bg-amber-500/[0.05] blur-[80px]"
		>
		</div>
		<div
			class="absolute inset-0 opacity-[0.35] mix-blend-overlay"
			style="background-image: url(\"data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.06'/%3E%3C/svg%3E\");"
		>
		</div>
		<div
			class="absolute inset-0 bg-[linear-gradient(to_right,rgba(255,255,255,0.03)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.03)_1px,transparent_1px)] bg-[size:72px_72px] opacity-40 [mask-image:linear-gradient(to_bottom,black_20%,transparent_95%)]"
		>
		</div>
	</div>

	<div class="relative mx-auto max-w-7xl px-5 md:px-8">
		<div data-animate>
			<div
				class="inline-flex items-center gap-2.5 rounded-full border border-white/10 bg-white/[0.04] px-4 py-2 text-[11px] font-semibold uppercase tracking-[0.22em] text-white/55 backdrop-blur-sm"
			>
				<span class="h-1.5 w-1.5 rounded-full bg-[#18b24b] shadow-[0_0_12px_#18b24b]" aria-hidden="true"></span>
				Terreno dedicato
			</div>
			<h2
				class="mt-7 max-w-[14ch] text-balance font-bold leading-[1.08] tracking-tight text-white text-[clamp(2.1rem,4.5vw,3.35rem)]"
			>
				Flow Ride Park
			</h2>
			<p class="mt-6 max-w-xl text-lg leading-relaxed text-white/58">
				Tre piste scalate per livello — dalla prima curva al salto misurato. Un percorso di crescita chiaro, con
				sicurezza e tecnica al centro.
			</p>
		</div>

		<!-- Schede: carosello a passi su mobile, griglia su lg -->
		<div class="relative mt-16 md:mt-20 lg:mt-24" data-animate>
			<div
				id="flow-park-carousel"
				class="flow-park-track -mx-5 flex snap-x snap-mandatory gap-4 overflow-x-auto scroll-smooth px-5 pb-1 [scrollbar-width:none] [-ms-overflow-style:none] lg:mx-0 lg:grid lg:grid-cols-3 lg:gap-7 lg:overflow-visible lg:px-0 lg:pb-0 [&::-webkit-scrollbar]:hidden"
				role="region"
				aria-roledescription="carousel"
				aria-label="Tre passi del Flow Ride Park"
				tabindex="0"
			>
				{
					tracks.map((t, i) => (
						<article
							id={`flow-park-slide-${i}`}
							data-flow-park-slide
							data-flow-title={t.title}
							class:list={[
								"flow-park-slide group relative flex-[0_0_100%] snap-center lg:min-w-0 lg:flex-none lg:snap-none",
								"flex flex-col rounded-[1.35rem] border bg-gradient-to-b from-white/[0.06] to-white/[0.015] shadow-[0_24px_80px_-40px_rgba(0,0,0,0.85)] backdrop-blur-sm transition duration-500",
								t.border,
								"lg:hover:-translate-y-2",
								t.glow,
							]}
							aria-label={`Passo ${i + 1} di 3: ${t.title}`}
							role="group"
							aria-roledescription="slide"
						>
							<div class="relative flex flex-1 flex-col px-7 pb-8 pt-7 md:px-8 md:pb-9 md:pt-8">
								<span
									class="pointer-events-none select-none font-mono text-[4.5rem] font-bold leading-none tabular-nums text-white/35 transition duration-500 group-hover:text-white/50 lg:text-[5rem]"
									aria-hidden="true"
								>
									0{i + 1}
								</span>
								<div class="relative -mt-14 flex flex-1 flex-col">
									<div class="flex justify-end">
										<span class="rounded-full border border-white/10 bg-white/[0.06] px-3 py-1 text-[11px] font-semibold uppercase tracking-wider text-white/55">
											{t.tag}
										</span>
									</div>
									<h3 class="mt-5 text-xl font-bold tracking-tight text-white lg:text-[1.35rem]">{t.title}</h3>
									<p class="mt-3 flex-1 text-sm leading-relaxed text-white/58 md:text-[15px]">{t.text}</p>
									<div class="mt-8 flex items-center gap-2 border-t border-white/[0.06] pt-6">
										<span class="h-px flex-1 bg-gradient-to-r from-white/25 to-transparent" aria-hidden="true" />
										<span class="text-[11px] font-medium uppercase tracking-[0.2em] text-white/35">
											Livello {i + 1} / 3
										</span>
									</div>
								</div>
							</div>
						</article>
					))
				}
			</div>

			<div class="mt-6 flex flex-col items-center gap-4 lg:hidden">
				<p id="flow-park-step-status" class="text-center text-sm text-white/70" aria-live="polite">
					<span class="font-semibold text-white">Passo 1</span>
					<span class="text-white/40"> di 3 · </span>
					<span class="text-white/85">{tracks[0].title}</span>
				</p>
				<nav class="flex w-full max-w-xs items-center justify-between gap-1 px-1" aria-label="Passi del percorso">
					{
						tracks.map((t, i) => (
							<button
								type="button"
								class:list={[
									"flow-park-step-btn flex min-h-11 min-w-0 flex-1 flex-col items-center justify-center rounded-xl border px-1 py-2 text-center transition",
									i === 0
										? "border-emerald-400/50 bg-emerald-500/15 text-white shadow-[0_0_24px_-8px_rgba(52,211,153,0.35)]"
										: "border-white/12 bg-white/[0.04] text-white/55",
								]}
								data-flow-park-step={i}
								aria-current={i === 0 ? "true" : "false"}
								aria-controls={`flow-park-slide-${i}`}
								aria-label={`Passo ${i + 1}: ${t.title}`}
							>
								<span class="text-[10px] font-semibold uppercase tracking-[0.18em] text-white/45">Passo</span>
								<span class="text-lg font-bold tabular-nums leading-none">{i + 1}</span>
							</button>
						))
					}
				</nav>
			</div>
		</div>
	</div>
</section>

<script>
	let flowParkIo = null;
	let flowParkAbort = null;

	function initFlowParkCarousel() {
		const track = document.getElementById("flow-park-carousel");
		const slides = document.querySelectorAll("[data-flow-park-slide]");
		const stepBtns = document.querySelectorAll(".flow-park-step-btn");
		const statusEl = document.getElementById("flow-park-step-status");
		if (!track || slides.length < 2 || !statusEl) return;

		if (flowParkAbort) flowParkAbort.abort();
		flowParkAbort = new AbortController();
		const { signal } = flowParkAbort;

		if (flowParkIo) {
			flowParkIo.disconnect();
			flowParkIo = null;
		}

		const activeClasses = [
			"border-emerald-400/50",
			"bg-emerald-500/15",
			"text-white",
			"shadow-[0_0_24px_-8px_rgba(52,211,153,0.35)]",
		];
		const idleClasses = ["border-white/12", "bg-white/[0.04]", "text-white/55"];

		function setActive(index) {
			const title = slides[index]?.getAttribute("data-flow-title") ?? "";
			statusEl.innerHTML = `<span class="font-semibold text-white">Passo ${index + 1}</span><span class="text-white/40"> di 3 · </span><span class="text-white/85">${title}</span>`;
			stepBtns.forEach((btn, i) => {
				const on = i === index;
				btn.setAttribute("aria-current", on ? "true" : "false");
				activeClasses.forEach((c) => btn.classList.toggle(c, on));
				idleClasses.forEach((c) => btn.classList.toggle(c, !on));
			});
		}

		flowParkIo = new IntersectionObserver(
			(entries) => {
				for (const e of entries) {
					if (!e.isIntersecting) continue;
					const idx = Array.from(slides).indexOf(e.target);
					if (idx >= 0) setActive(idx);
				}
			},
			{ root: track, threshold: 0.55 },
		);
		slides.forEach((s) => flowParkIo.observe(s));

		stepBtns.forEach((btn, i) => {
			btn.addEventListener(
				"click",
				() => {
					slides[i]?.scrollIntoView({ behavior: "smooth", inline: "nearest", block: "nearest" });
				},
				{ signal },
			);
		});
	}

	initFlowParkCarousel();
	document.addEventListener("astro:page-load", initFlowParkCarousel);
</script>
